import React, { useState, useEffect } from "react";
import { 
  Building2, 
  Clock, 
  History, 
  Plus, 
  RotateCcw, 
  Check, 
  Trash2, 
  Cloud, 
  CloudOff,
  Layers
} from "lucide-react";

// Initial Grid options: P11 to P1, T1 to T3, K1 to K3
const GRID_OPTIONS = [
  "P11", "P10", "P9", "P8", "P7", "P6", "P5", "P4", "P3", "P2", "P1",
  "T1", "T2", "T3",
  "K1", "K2", "K3"
];

const DEFAULT_SERVICES = ["120", "192", "194", "CMA", "225"];
const SIZES = ["20ft", "40ft", "40ft HC", "45ft"];

const INITIAL_ROWS = Array.from({ length: 12 }, (_, index) => ({
  id: index + 1,
  grid: "",
  size: "40ft",
  service: "120",
  lastUpdated: ""
}));

export default function YardTracker() {
  const [activeTab, setActiveTab] = useState("tracker");
  const [rows, setRows] = useState(() => {
    const saved = localStorage.getItem("yard_rows");
    return saved ? JSON.parse(saved) : INITIAL_ROWS;
  });
  
  const [services, setServices] = useState(() => {
    const saved = localStorage.getItem("yard_services");
    return saved ? JSON.parse(saved) : DEFAULT_SERVICES;
  });

  const [history, setHistory] = useState(() => {
    const saved = localStorage.getItem("yard_history");
    return saved ? JSON.parse(saved) : [];
  });

  const [newServiceInput, setNewServiceInput] = useState("");
  const [showAddService, setShowAddService] = useState(false);
  const [isConnected, setIsConnected] = useState(true);

  // Save changes locally
  useEffect(() => {
    localStorage.setItem("yard_rows", JSON.stringify(rows));
  }, [rows]);

  useEffect(() => {
    localStorage.setItem("yard_services", JSON.stringify(services));
  }, [services]);

  useEffect(() => {
    localStorage.setItem("yard_history", JSON.stringify(history));
  }, [history]);

  const handleRowChange = (id, field, value) => {
    const now = new Date().toLocaleString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });

    setRows(prevRows =>
      prevRows.map(row => {
        if (row.id === id) {
          const updatedRow = { ...row, [field]: value, lastUpdated: now };
          
          // Add entry to history log
          if (row.grid !== "" || value !== "") {
            const logEntry = {
              id: Date.now(),
              timestamp: now,
              rowId: id,
              grid: field === "grid" ? value : row.grid,
              size: field === "size" ? value : row.size,
              service: field === "service" ? value : row.service,
              action: `Updated ${field.toUpperCase()} to ${value || "Empty"}`
            };
            setHistory(prev => [logEntry, ...prev.slice(0, 49)]);
          }

          return updatedRow;
        }
        return row;
      })
    );
  };

  const clearRow = (id) => {
    const rowToClear = rows.find(r => r.id === id);
    if (!rowToClear || !rowToClear.grid) return;

    const now = new Date().toLocaleString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });

    setRows(prevRows =>
      prevRows.map(row =>
        row.id === id
          ? { ...row, grid: "", lastUpdated: now }
          : row
      )
    );

    const logEntry = {
      id: Date.now(),
      timestamp: now,
      rowId: id,
      grid: rowToClear.grid,
      size: rowToClear.size,
      service: rowToClear.service,
      action: "Cleared Slot"
    };
    setHistory(prev => [logEntry, ...prev.slice(0, 49)]);
  };

  const handleAddService = (e) => {
    e.preventDefault();
    if (newServiceInput.trim() && !services.includes(newServiceInput.trim())) {
      setServices([...services, newServiceInput.trim()]);
      setNewServiceInput("");
      setShowAddService(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 font-sans p-4 md:p-6">
      {/* Top Header */}
      <header className="max-w-6xl mx-auto mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
            <Building2 className="text-blue-500" /> Yard Grid Planner
          </h1>
          <p className="text-sm text-slate-400">12 Descending Active Grid Inputs</p>
        </div>

        <div className="flex items-center gap-3">
          <div className="flex bg-slate-800 p-1 rounded-lg border border-slate-700">
            <button
              onClick={() => setActiveTab("tracker")}
              className={`px-4 py-2 rounded-md text-sm font-medium transition ${
                activeTab === "tracker"
                  ? "bg-blue-600 text-white"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              Active Grid
            </button>
            <button
              onClick={() => setActiveTab("history")}
              className={`px-4 py-2 rounded-md text-sm font-medium transition flex items-center gap-1.5 ${
                activeTab === "history"
                  ? "bg-blue-600 text-white"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              <History className="w-4 h-4" /> Movement Log
            </button>
          </div>

          <button
            onClick={() => setShowAddService(!showAddService)}
            className="flex items-center gap-1.5 px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sm font-medium rounded-lg text-blue-400 transition"
          >
            <Plus className="w-4 h-4" /> Add Service
          </button>
        </div>
      </header>

      {/* Add Custom Service Popup */}
      {showAddService && (
        <div className="max-w-6xl mx-auto mb-6 bg-slate-800 border border-blue-500/30 p-4 rounded-xl shadow-lg">
          <form onSubmit={handleAddService} className="flex items-center gap-3">
            <input
              type="text"
              value={newServiceInput}
              onChange={(e) => setNewServiceInput(e.target.value)}
              placeholder="Enter new service code (e.g. 301, MSC)"
              className="bg-slate-900 border border-slate-700 text-white text-sm rounded-lg p-2.5 flex-1 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
            <button
              type="submit"
              className="bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm px-4 py-2.5 rounded-lg transition"
            >
              Save Service
            </button>
          </form>
        </div>
      )}

      {/* Main Active Input Grid Table */}
      {activeTab === "tracker" && (
        <main className="max-w-6xl mx-auto bg-slate-800/80 rounded-xl border border-slate-700/60 overflow-hidden shadow-2xl">
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-slate-950 text-slate-400 text-xs font-bold uppercase border-b border-slate-700">
                  <th className="py-3 px-4 w-12 text-center">#</th>
                  <th className="py-3 px-4">Grid Location</th>
                  <th className="py-3 px-4">Size</th>
                  <th className="py-3 px-4">Service</th>
                  <th className="py-3 px-4">Last Updated</th>
                  <th className="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-700/50">
                {rows.map((row) => (
                  <tr
                    key={row.id}
                    className="hover:bg-slate-700/30 transition-colors"
                  >
                    <td className="py-3 px-4 text-slate-500 font-mono text-xs text-center">
                      {row.id}
                    </td>

                    {/* GRID LOCATION Dropdown */}
                    <td className="py-3 px-4">
                      <select
                        value={row.grid}
                        onChange={(e) =>
                          handleRowChange(row.id, "grid", e.target.value)
                        }
                        className="w-full bg-slate-900 border border-slate-700 text-white font-semibold text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      >
                        <option value="">-- Select Grid --</option>
                        {GRID_OPTIONS.map((g) => (
                          <option key={g} value={g}>
                            {g}
                          </option>
                        ))}
                      </select>
                    </td>

                    {/* SIZE Dropdown */}
                    <td className="py-3 px-4">
                      <select
                        value={row.size}
                        onChange={(e) =>
                          handleRowChange(row.id, "size", e.target.value)
                        }
                        className="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      >
                        {SIZES.map((s) => (
                          <option key={s} value={s}>
                            {s}
                          </option>
                        ))}
                      </select>
                    </td>

                    {/* SERVICE Dropdown */}
                    <td className="py-3 px-4">
                      <select
                        value={row.service}
                        onChange={(e) =>
                          handleRowChange(row.id, "service", e.target.value)
                        }
                        className="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      >
                        {services.map((svc) => (
                          <option key={svc} value={svc}>
                            {svc}
                          </option>
                        ))}
                      </select>
                    </td>

                    {/* LAST UPDATED */}
                    <td className="py-3 px-4 text-xs text-slate-400 font-mono">
                      {row.lastUpdated ? (
                        <span className="flex items-center gap-1">
                          <Clock className="w-3.5 h-3.5 text-blue-400" />
                          {row.lastUpdated}
                        </span>
                      ) : (
                        <span className="text-slate-600">--</span>
                      )}
                    </td>

                    {/* ACTIONS */}
                    <td className="py-3 px-4 text-right">
                      <button
                        onClick={() => clearRow(row.id)}
                        disabled={!row.grid}
                        className="p-2 text-slate-500 hover:text-red-400 hover:bg-slate-700/50 rounded-lg disabled:opacity-30 disabled:hover:text-slate-500 transition"
                        title="Clear Slot"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </main>
      )}

      {/* Movement History Log */}
      {activeTab === "history" && (
        <main className="max-w-6xl mx-auto bg-slate-800/80 rounded-xl border border-slate-700/60 p-4">
          <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <History className="text-blue-400" /> Previous Moves & Update History
          </h2>
          {history.length === 0 ? (
            <p className="text-slate-500 text-sm italic">No recent yard changes logged yet.</p>
          ) : (
            <div className="space-y-2">
              {history.map((log) => (
                <div
                  key={log.id}
                  className="bg-slate-900/60 border border-slate-700/50 rounded-lg p-3 flex items-center justify-between text-sm"
                >
                  <div className="flex items-center gap-3">
                    <span className="font-bold text-blue-400 bg-blue-500/10 px-2 py-1 rounded border border-blue-500/20">
                      {log.grid || "N/A"}
                    </span>
                    <span className="text-slate-300">
                      {log.size} | Service: <strong className="text-white">{log.service}</strong>
                    </span>
                  </div>
                  <div className="flex items-center gap-4">
                    <span className="text-slate-400 text-xs">{log.action}</span>
                    <span className="text-slate-500 text-xs font-mono">{log.timestamp}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </main>
      )}
    </div>
  );
}
